# ShyRe Creations - Server Configuration
PORT=5001

# Recipient email where client commissions will be received
COMMISSION_RECEIVER_EMAIL=hello@shyrecreations.com

# SMTP Settings (e.g., Gmail, Outlook, Amazon SES, SendGrid, etc.)
# For Gmail, generate an "App Password" under your Google Account Security settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: If you want to use an ethereal test account automatically when SMTP credentials are empty
# Set USE_TEST_ACCOUNT=true to test without real SMTP credentials
USE_TEST_ACCOUNT=true
